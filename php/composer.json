        "apiverve",
        "weatherseasons",
        "solstice and equinox api",
        "equinox dates",
        "solstice dates",
        "spring equinox date",
        "summer solstice timing"
    ],
    "homepage": "https://apiverve.com/marketplace/weatherseasons?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/weatherseasons",
        "source": "https://github.com/apiverve/weatherseasons-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
